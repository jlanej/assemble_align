+/*********************************************************************************************
+ * Open-closed mod-minimizer (Groot Koerkamp & Pibiri 2024; Groot Koerkamp, Liu & Pibiri 2025),
+ * strand-symmetric version.  In each window of w consecutive k-mers (L = w+k-1 bases) find the
+ * smallest t-mer, t = r + ((k-r) mod w), r = 4, under the order (class, splitmix56(canonical t-mer)),
+ * where class 0/1/2 = open syncmer / closed syncmer / other with respect to canonical s-mers
+ * (s = smallest value >= 4 (3 if t < 6) with t-s even; open offset (t-s)/2 is then the unique
+ * mirror-symmetric centre).  If the smallest t-mer starts at window offset x, the k-mer at offset
+ * x mod w is sampled.  Because k-t is a multiple of w, the selection is identical on both strands
+ * (ties between identical t-mers are broken by splitmix56 of the candidate canonical k-mer).
+ * When t == k this is the open-closed minimizer.  The emitted key is minimap2's usual
+ * hash64(canonical k-mer)<<8 | span, so the index format and seeding are unchanged.
+ *********************************************************************************************/
+static inline uint64_t mm_mix56(uint64_t x)
+{
+	x ^= 0x9E3779B97F4A7C15ULL;
+	x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;
+	x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;
+	x ^= x >> 31;
+	return x >> 8;
+}
+
+#define MODOC_RB 512
+#define MODOC_M (MODOC_RB - 1)
+
+static void mm_sketch_modoc(void *km, const char *str, int len, int w, int k, uint32_t rid, mm128_v *p)
+{
+	const int r = 4;
+	int t = k < r? k : r + (k - r) % w;
+	int s, v, use_oc, l = 0, nt = w + k - t, L = w + k - 1;
+	uint64_t kmask = (1ULL<<2*k) - 1, tmask = (1ULL<<2*t) - 1, smask;
+	uint64_t kf = 0, kr = 0, tf = 0, tr = 0, sf = 0, sr = 0;
+	uint64_t shash[MODOC_RB], trank[MODOC_RB], kx[MODOC_RB], ky[MODOC_RB], kh[MODOC_RB];
+	int64_t sdq[MODOC_RB], tdq[MODOC_RB], sh = 0, st = 0, th = 0, tt = 0, i, last = -1;
+	size_t n0 = p->n, a, b;
+	assert(w + k < MODOC_RB);
+	s = t >= 6? 4 : 3;
+	while ((t - s) & 1) ++s;
+	use_oc = (t > 4 && s < t);
+	v = (t - s) / 2;
+	smask = (1ULL<<2*s) - 1;
+	kv_resize(mm128_t, km, *p, p->n + len/w + 16);
+	for (i = 0; i < len; ++i) {
+		int c = seq_nt4_table[(uint8_t)str[i]], j = i & MODOC_M;
+		if (c >= 4) { l = 0, sh = st = th = tt = 0; continue; }
+		++l;
+		kf = (kf << 2 | c) & kmask, kr = (kr >> 2) | (3ULL^c) << (2*(k-1));
+		tf = (tf << 2 | c) & tmask, tr = (tr >> 2) | (3ULL^c) << (2*(t-1));
+		if (use_oc) {
+			sf = (sf << 2 | c) & smask, sr = (sr >> 2) | (3ULL^c) << (2*(s-1));
+			if (l >= s) {
+				shash[j] = mm_mix56((sf < sr? sf : sr) ^ 0x5bd1e995ULL);
+				while (st > sh && shash[sdq[(st-1)&MODOC_M] & MODOC_M] > shash[j]) --st;
+				sdq[st++ & MODOC_M] = i;
+			}
+		}
+		if (l >= t) {
+			uint64_t cls = 0;
+			if (use_oc) {
+				int64_t first = i - (t - s);
+				uint64_t m;
+				while (sdq[sh & MODOC_M] < first) ++sh;
+				m = shash[sdq[sh & MODOC_M] & MODOC_M];
+				if (shash[(first + v) & MODOC_M] == m || shash[(first + t - s - v) & MODOC_M] == m) cls = 0;
+				else if (shash[first & MODOC_M] == m || shash[j] == m) cls = 1;
+				else cls = 2;
+			}
+			trank[j] = cls << 58 | mm_mix56(tf < tr? tf : tr);
+			while (tt > th && trank[tdq[(tt-1)&MODOC_M] & MODOC_M] > trank[j]) --tt;
+			tdq[tt++ & MODOC_M] = i;
+		}
+		if (l >= k) {
+			if (kf == kr) kx[j] = UINT64_MAX; // symmetric k-mer: never sampled (as in mm_sketch)
+			else {
+				int z = kf < kr? 0 : 1;
+				kx[j] = hash64(z? kr : kf, kmask) << 8 | k;
+				ky[j] = (uint64_t)rid<<32 | (uint32_t)i<<1 | z;
+				kh[j] = mm_mix56(z? kr : kf);
+			}
+		}
+		if (l >= L) {
+			int64_t wstart = i - L + 1, best = -1, h;
+			uint64_t m, bh = UINT64_MAX;
+			while (tdq[th & MODOC_M] < i - nt + 1) ++th;
+			m = trank[tdq[th & MODOC_M] & MODOC_M];
+			for (h = th; h < tt && trank[tdq[h & MODOC_M] & MODOC_M] == m; ++h) {
+				int64_t x = tdq[h & MODOC_M] - (t - 1) - wstart, kend = wstart + x % w + k - 1;
+				int jj = kend & MODOC_M;
+				if (kx[jj] != UINT64_MAX && (best < 0 || kh[jj] < bh)) best = kend, bh = kh[jj];
+			}
+			if (best >= 0 && best != last) {
+				mm128_t mz;
+				mz.x = kx[best & MODOC_M], mz.y = ky[best & MODOC_M];
+				kv_push(mm128_t, km, *p, mz);
+				last = best;
+			}
+		}
+	}
+	// selected positions can step back by < w when the anchor t-mer changes: insertion-sort by y, dedup
+	for (a = n0 + 1; a < p->n; ++a) {
+		mm128_t tmp = p->a[a];
+		for (b = a; b > n0 && p->a[b-1].y > tmp.y; --b) p->a[b] = p->a[b-1];
+		p->a[b] = tmp;
+	}
+	for (a = b = n0; a < p->n; ++a)
+		if (b == n0 || p->a[a].y != p->a[b-1].y) p->a[b++] = p->a[a];
+	p->n = b;
+}
